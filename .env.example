# Copiez ce fichier en `.env` pour le développement local. Sur Vercel, chaque
# variable se déclare dans Settings → Environment Variables (ou `vercel env add`).
#
# EN PRODUCTION : tirez AUTH_SECRET et TOKEN_SECRET au hasard
# (`openssl rand -base64 32`). Changer TOKEN_SECRET après coup invalide tous
# les liens apprenants déjà distribués.

# --- Base de données : Supabase ---------------------------------------------------
# Supabase → Project Settings → Database → Connection string.
#   - Pour l'application (Vercel) : le pooler en mode « Transaction », port 6543.
#   - Pour `npm run migrate` / `npm run seed` : la connexion directe, port 5432,
#     ou le pooler en mode « Session ». Les migrations n'aiment pas le mode
#     transaction.
DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Fichiers : Supabase Storage ----------------------------------------------------
# Project Settings → API. La clé « service_role » reste côté serveur, jamais
# exposée au navigateur. Le bucket privé est créé par `npm run migrate`.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fichiers

# --- Secrets de l'application -------------------------------------------------------
AUTH_SECRET=remplacez_moi_auth_secret_32_caracteres_minimum
TOKEN_SECRET=remplacez_moi_token_secret_32_caracteres_minimum
# URL publique, utilisée dans les liens envoyés aux apprenants et aux formateurs.
APP_URL=http://localhost:3000

# --- Jeu de démonstration -------------------------------------------------------
# Mot de passe des comptes créés par `npm run seed` (admin@bantuhub.cg, formateur@bantuhub.cg).
SEED_PASSWORD=bantuhub2025

# --- Connexion Google (facultatif) ----------------------------------------------
# Identifiants OAuth « application Web » créés sur console.cloud.google.com, avec
# l'URI de redirection <APP_URL>/api/auth/callback/google. Sans ces variables, le
# bouton « Continuer avec Google » n'apparaît pas ; l'e-mail + mot de passe reste.
# Seules les adresses déjà enregistrées dans Utilisateurs peuvent se connecter.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Assistant de la FAQ (facultatif) --------------------------------------------
# Clé API Anthropic. Sans clé, la boîte « Une autre question ? » répond depuis
# le contenu de la page, sans aucun appel externe.
ANTHROPIC_API_KEY=

# --- Notifications (facultatif) --------------------------------------------------
# Courriel : SMTP classique. Gmail : smtp.gmail.com, port 465, mot de passe
# d'application. Sans ces variables, les messages restent « en attente ».
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS : un webhook HTTP qui reçoit { "to": "...", "body": "..." } en JSON.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
